NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — server-only. AI Assistant, "Explain this report", and the
# Weekly/Monthly Review AI summaries are gracefully disabled with no crash
# and no external API calls when this is unset. Never prefix with
# NEXT_PUBLIC_ — this key must never reach the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — server-only. Account e-mails (registration alert, approval, suspension) sent by
# /app/api/account-email. Without them the route answers 503 and the database keeps retrying.
# RESEND_API_KEY=            # "Sending access" only, restricted to the sending domain
# ACCOUNT_EMAIL_SECRET=      # random, 32+ characters; the same value as the Vault secret 'account_email_secret'
# ADMIN_NOTIFY_EMAIL=        # receives registration alerts; also the contact and reply-to address
# ACCOUNT_EMAIL_FROM=        # default: AMHIL OS <no-reply@mail.byamhil.com>

# Optional - public. Cloudflare Turnstile site key. When set, sign-in, sign-up and "forgot password"
# show a CAPTCHA and the sign-up link appears. The matching secret goes into Supabase, never here.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
